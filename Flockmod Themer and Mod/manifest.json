{
  "manifest_version": 3,
  "name": "FlockMod Themer",
  "version": "1.0.0",
  "description": "My personal FlockMod UI customization.",
  "content_scripts": [
    {
      "matches": ["https://flockmod.com/*"],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}